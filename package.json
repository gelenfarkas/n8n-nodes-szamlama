{
  "name": "n8n-nodes-szamlama",
  "version": "0.1.1",
  "description": "n8n community node for Számláma, the Hungarian online invoicing service: issue invoices from your workflows and react to document events.",
  "license": "MIT",
  "homepage": "https://szamlama.hu/",
  "keywords": [
    "n8n-community-node-package",
    "szamlama",
    "invoice",
    "invoicing",
    "hungary",
    "nav",
    "számla"
  ],
  "author": {
    "name": "Software-Wolf Kft.",
    "email": "help@szamlama.hu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gelenfarkas/n8n-nodes-szamlama.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SzamlamaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Szamlama/Szamlama.node.js",
      "dist/nodes/Szamlama/SzamlamaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}